// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Spoolman",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/python:1": {
			"installTools": true,
			"version": "3.11"
		},
		"ghcr.io/devcontainers-extra/features/pdm:2": {
			"version": "latest"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"GitHub.copilot-chat",
				"github.copilot-workspace",
				"GitHub.copilot",
				"ms-python.autopep8",
				"ms-python.debugpy",
				"ms-python.python",
				"ms-python.vscode-pylance"
			]
		}
	},
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [
		5173,
		8000
	],
	"containerEnv": {
		"VITE_APIURL": "http://localhost:8000/api/v1",
		"SPOOLMAN_DEBUG_MODE": "1",
		"SPOOLMAN_DIR_DATA": "/workspaces/data"
	},
	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": {
		"frontend": "cd client && npm install --include=dev",
		"backend": "test -f .venv && pdm venv create python3.11; pdm install --with dev"
	},
	"postStartCommand": {
		"frontend": "cd client && npm run dev | tee frontend.log",
		"backend": "pdm run uvicorn spoolman.main:app --reload --reload-dir spoolman | tee backend.log"
	}
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}